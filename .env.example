# ============================================================
# ZONEVIEW ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to Git.

# ---- Application ----
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql://zoneview_user:zoneview_password@localhost:5432/zoneview_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ---- AI ----
OPENAI_API_KEY=your_openai_api_key

# ---- Storage (S3-compatible) ----
STORAGE_BUCKET=zoneview
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_ENDPOINT=https://s3.amazonaws.com